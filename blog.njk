---
layout: base.njk
title: DERRICK FINK // DATA_LOGS
---

<header class="hero" style="padding-bottom: 3rem;">
  <div class="hero-watermark">LOG</div>
  <h1>Data<br>Logs</h1>
  <p class="hero-desc">Personal transmissions, technical teardowns, and architectural notes.</p>
</header>

<section class="grid-row">
  <div class="grid-label mono">
    // ARCHIVE<br>
    ALL_POSTS<br>
    <span style="color: var(--border);">-------------</span><br>
    <span style="color: var(--muted);">COUNT: {{ collections.post.length }}</span>
  </div>
  <div class="grid-content">
    {% for post in collections.post | reverse %}
      <a href="{{ post.url }}" class="work-card cyan-hover">
        <div class="work-meta mono">
          <span>{{ post.date | isoDate }}</span>
          <span>[ LOG_{{ loop.index }} ]</span>
        </div>
        <h3 class="work-title">{{ post.data.title }}</h3>
      </a>
    {% else %}
      <div class="work-card">
        <p class="mono" style="margin-bottom: 0;">No transmissions found.</p>
      </div>
    {% endfor %}
  </div>
</section>
