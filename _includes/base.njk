<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{ title | default("DERRICK FINK // SYS.OP") }}</title>
    <meta name="description" content="Derrick Fink — Senior Software Engineer at Boise State University. Architecting high-availability web applications, multi-LLM platforms, and resilient cloud infrastructure." />
    
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&family=JetBrains+Mono:wght@400;700;800&display=swap" rel="stylesheet" />

    <style>
      :root {
        --bg: #030303;
        --fg: #f4f4f5;
        --muted: #888888;
        --border: #333333;
        
        --neon-yellow: #d6ff00;
        --neon-cyan: #00f0ff;
        --neon-red: #ff003c;
      }

      * { box-sizing: border-box; margin: 0; padding: 0; }

      body {
        background-color: var(--bg);
        color: var(--fg);
        font-family: 'Inter', sans-serif;
        font-size: 16px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        background-image: radial-gradient(var(--border) 1px, transparent 1px);
        background-size: 24px 24px;
        background-position: center top;
        padding: 2rem 1rem;
      }

      .mono { font-family: 'JetBrains Mono', monospace; }

      .wrapper {
        max-width: 1200px;
        margin: 0 auto;
        background: var(--bg);
        border: 1px solid var(--border);
        position: relative;
        box-shadow: 0 0 50px rgba(0, 0, 0, 0.8);
      }

      .crosshair {
        position: absolute;
        width: 15px; height: 15px;
        z-index: 10;
      }
      .crosshair::before, .crosshair::after {
        content: ''; position: absolute; background: var(--neon-cyan);
      }
      .crosshair::before { top: 7px; left: 0; width: 15px; height: 1px; }
      .crosshair::after { top: 0; left: 7px; width: 1px; height: 15px; }
      
      .ch-tl { top: -7px; left: -7px; }
      .ch-tr { top: -7px; right: -7px; }
      .ch-bl { bottom: -7px; left: -7px; }
      .ch-br { bottom: -7px; right: -7px; }

      .top-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 1.5rem;
        border-bottom: 1px solid var(--border);
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--neon-yellow);
      }
      .top-bar a {
        color: var(--neon-yellow);
        text-decoration: none;
      }
      .top-bar a:hover {
        color: var(--neon-cyan);
      }
      .top-bar-left { display: flex; gap: 2rem; }
      .blink { animation: blinker 1s linear infinite; }
      @keyframes blinker { 50% { opacity: 0; } }

      .hero {
        padding: 6rem 1.5rem;
        border-bottom: 1px solid var(--border);
        position: relative;
        overflow: hidden;
      }
      
      .hero h1 {
        font-size: clamp(3.5rem, 10vw, 9rem);
        font-weight: 900;
        line-height: 0.85;
        letter-spacing: -0.05em;
        text-transform: uppercase;
        margin-bottom: 2rem;
        position: relative;
        z-index: 2;
      }

      .hero-desc {
        font-size: clamp(1.1rem, 3vw, 1.5rem);
        max-width: 600px;
        color: var(--muted);
        position: relative;
        z-index: 2;
      }

      .hero-watermark {
        position: absolute;
        top: -5%;
        right: -5%;
        font-size: 20rem;
        font-weight: 900;
        line-height: 0.8;
        color: rgba(255, 255, 255, 0.02);
        z-index: 1;
        pointer-events: none;
        user-select: none;
      }

      .hero-blog-link {
        position: absolute;
        bottom: 1.5rem;
        right: 1.5rem;
        color: var(--neon-cyan);
        text-decoration: none;
        font-size: 0.85rem;
        letter-spacing: 0.1em;
        z-index: 10;
        transition: color 0.2s ease;
      }
      .hero-blog-link:hover {
        color: var(--neon-yellow);
      }

      .grid-row {
        display: grid;
        grid-template-columns: 1fr;
        border-bottom: 1px solid var(--border);
      }
      @media (min-width: 800px) {
        .grid-row { grid-template-columns: 300px 1fr; }
      }
      .grid-row:last-child { border-bottom: none; }

      .grid-label {
        padding: 2rem 1.5rem;
        border-right: 1px solid transparent;
        color: var(--neon-cyan);
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        line-height: 1.8;
      }
      @media (min-width: 800px) {
        .grid-label { border-right: 1px solid var(--border); }
      }

      .grid-content { padding: 2rem 1.5rem; }

      h2 {
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 1.5rem;
        text-transform: uppercase;
        letter-spacing: -0.02em;
        color: var(--fg);
      }
      p { margin-bottom: 1.5rem; font-size: 1.1rem; color: var(--muted); }
      p:last-child { margin-bottom: 0; }

      .work-card {
        display: block;
        text-decoration: none;
        color: var(--fg);
        border: 1px solid var(--border);
        padding: 2rem;
        margin-bottom: 2rem;
        position: relative;
        background: var(--bg);
        transition: all 0.2s ease;
      }
      .work-card:last-child { margin-bottom: 0; }

      .work-card::before {
        content: '';
        position: absolute;
        top: 0; left: 0; width: 4px; height: 100%;
        background: var(--border);
        transition: all 0.2s ease;
      }

      .work-meta {
        display: flex;
        justify-content: space-between;
        margin-bottom: 1rem;
        font-size: 0.85rem;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }

      .work-title {
        font-size: 1.75rem;
        font-weight: 900;
        text-transform: uppercase;
        margin-bottom: 0.5rem;
        letter-spacing: -0.02em;
      }

      .work-card:hover {
        background: var(--neon-yellow);
        border-color: var(--neon-yellow);
        color: #000;
      }
      .work-card:hover::before { background: #000; }
      .work-card:hover .work-meta { color: rgba(0,0,0,0.6); }
      .work-card:hover p { color: #000; }

      .work-card.cyan-hover:hover {
        background: var(--neon-cyan);
        border-color: var(--neon-cyan);
      }
      
      .tags { display: flex; flex-wrap: wrap; gap: 0.75rem; }
      .tag {
        border: 1px solid var(--border);
        padding: 0.5rem 1rem;
        font-size: 0.85rem;
        text-transform: uppercase;
        color: var(--fg);
        background: var(--bg);
        transition: all 0.2s ease;
      }
      .tag:hover {
        background: var(--neon-cyan);
        border-color: var(--neon-cyan);
        color: #000;
        box-shadow: 0 0 15px rgba(0, 240, 255, 0.4);
      }

      .comm-link {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1.5rem;
        border: 1px solid var(--border);
        color: var(--fg);
        text-decoration: none;
        font-size: 1.25rem;
        font-weight: 700;
        text-transform: uppercase;
        margin-bottom: 1rem;
        transition: all 0.2s ease;
      }
      .comm-link:last-child { margin-bottom: 0; }
      
      .comm-link span.arrow {
        color: var(--muted);
        transition: color 0.2s ease, transform 0.2s ease;
      }

      .comm-link:hover { background: var(--fg); color: #000; }
      .comm-link:hover span.arrow { color: #000; transform: translateX(5px); }

      footer {
        padding: 2rem 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-top: 1px solid var(--border);
        font-size: 0.85rem;
        color: var(--muted);
      }
      .footer-links a { color: var(--neon-cyan); text-decoration: none; margin-left: 1.5rem; }
      .footer-links a:hover { text-decoration: underline; color: var(--neon-yellow); }

      /* Markdown Post Specific Styles */
      .post-content h1 { font-size: 3rem; margin-bottom: 1rem; color: var(--neon-cyan); text-transform: uppercase; letter-spacing: -0.05em; line-height: 1.1; }
      .post-content h2 { font-size: 2rem; margin-top: 3rem; margin-bottom: 1rem; }
      .post-content p { font-size: 1.2rem; margin-bottom: 1.5rem; color: var(--muted); }
      .post-content a { color: var(--neon-yellow); text-decoration: none; border-bottom: 1px solid var(--neon-yellow); transition: all 0.2s ease; }
      .post-content a:hover { background: var(--neon-yellow); color: #000; }
      .post-content pre { background: rgba(255,255,255,0.05); border: 1px solid var(--border); padding: 1.5rem; overflow-x: auto; margin-bottom: 2rem; }
      .post-content code { font-family: 'JetBrains Mono', monospace; font-size: 0.9em; color: var(--neon-cyan); }
      .post-content ul, .post-content ol { margin-bottom: 1.5rem; padding-left: 1.5rem; color: var(--muted); font-size: 1.2rem; }
      .post-content li { margin-bottom: 0.5rem; }
      .post-content blockquote { border-left: 4px solid var(--neon-cyan); padding-left: 1rem; margin-bottom: 1.5rem; font-style: italic; }
    </style>
  </head>
  <body>
    <div class="wrapper">
      <div class="crosshair ch-tl"></div>
      <div class="crosshair ch-tr"></div>
      <div class="crosshair ch-bl"></div>
      <div class="crosshair ch-br"></div>

      <nav class="top-bar mono">
        <div class="top-bar-left">
          <a href="/">> SYS.INIT</a>
          <a href="/blog.html">> READ_LOGS</a>
          <span style="color: var(--muted);">v2.0.26</span>
        </div>
        <div>
          <span class="blink">_</span>ONLINE // BOISE_ID
        </div>
      </nav>

      {{ content | safe }}

      <footer class="mono">
        <div>© 2026 DERRICK FINK // EOD</div>
        <div class="footer-links">
          <a href="/blog.html" style="color: var(--neon-yellow); margin-right: 1.5rem;">[ ACCESS_LOGS ]</a>
          <span>ALT_OS:</span>
          <a href="/win95.html">WIN_95</a>
          <a href="/mobile.html">IPAQ</a>
        </div>
      </footer>
    </div>
  </body>
</html>
